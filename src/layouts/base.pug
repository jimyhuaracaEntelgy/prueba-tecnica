mixin tarjeta(date, titulo, descripcion, imagen = null)
  article(class=`card card--${tipo}`)
    if imagen
      img.card__img(src=imagen, alt=titulo)
    .card__body
      span.card__tag= date
      h2.card__title= titulo
      p.card__desc= descripcion
      button.card__btn Read More

doctype html
html(lang='es')
    head
        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1')
        meta(name='description' content='Prueba técnica de Front-End.')
        title Prueba técnica
        script(type='module' src='/src/scripts/main.js')
        link(rel='stylesheet' href='/src/styles/main.scss')
    body
        main
            block content
